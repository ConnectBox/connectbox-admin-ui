extends ../../../layout/form
include ../../../mixins/switch

//- Front-panel Internet page (data sent and received for internet sharing); brand.j2 lcd_pages_internet (2026-11-13). Off by default; connectbox-manage turns it on when internet sharing is turned on, and off again when sharing is turned off unless the admin turned it on by hand.
block variables
    - var id = 'lcd_pages_internet'

block icon
    include ../../../icons/screens

block title
    | Show LCD Internet Data Page

block form
    div.position-relative
        +switch('lcd_pages_internet', 'Show LCD Internet Data Page')
